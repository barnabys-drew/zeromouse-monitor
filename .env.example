# Copy to `.env` in this directory:
#   cp .env.example .env
#
# Subscribe to the same topic in the ntfy app (https://ntfy.sh).
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
CHECK_INTERVAL=900
# Optional: seconds between repeat in-stock notifications (default 3600)
# NOTIFY_COOLDOWN=3600
# Optional: consecutive failed checks before a "monitor is failing" alert (default 8)
# FAILURE_ALERT_THRESHOLD=8
# Optional: path inside container (default matches volume layout)
# STATE_FILE=data/.zeromouse_state.json
